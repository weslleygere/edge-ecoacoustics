{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ESP32-S3 firmware",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/firmware/esp32s3/build.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
